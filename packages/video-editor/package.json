{
  "name": "@austencloud/video-editor",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "Keyframe video editor for Svelte 5 apps: project schema, frame compositor, WebCodecs export and the editor UI. Shared by tka-platform and Ringmaster.",
  "type": "module",
  "svelte": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js"
    },
    "./encoder": {
      "types": "./dist/encoder/index.d.ts",
      "import": "./dist/encoder/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "svelte": "./dist/ui/index.js",
      "import": "./dist/ui/index.js"
    },
    "./strings": {
      "types": "./dist/strings/index.d.ts",
      "import": "./dist/strings/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "svelte": "./dist/icons/index.js",
      "import": "./dist/icons/index.js"
    },
    "./css/*": "./css/*"
  },
  "sideEffects": [
    "./css/*"
  ],
  "files": [
    "dist",
    "css"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "dev": "svelte-package -i src -o dist --watch",
    "check": "svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.test.json",
    "test": "node --test test/*.test.mjs && vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.0.1",
    "dexie": "^4.2.1",
    "h264-mp4-encoder": "^1.0.12",
    "realtime-bpm-analyzer": "5.0.0",
    "wavesurfer.js": "7.12.1",
    "zod": "^4.2.1"
  },
  "peerDependencies": {
    "mediabunny": "^1.44.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "jsdom": "^27.4.0",
    "mediabunny": "~1.44.2",
    "playwright": "1.61.1",
    "rimraf": "^5.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.16",
    "vitest-browser-svelte": "2.1.1"
  },
  "keywords": [
    "svelte",
    "video",
    "editor",
    "keyframes",
    "webcodecs",
    "austencloud"
  ],
  "author": "Austen Cloud <austencloud@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/austencloud/shared-packages.git",
    "directory": "packages/video-editor"
  }
}
