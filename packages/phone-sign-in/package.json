{
  "name": "@austencloud/phone-sign-in",
  "version": "0.2.0",
  "description": "Scan a QR code with your signed-in phone to sign a computer in to a Firebase app. One-time approvals, a trusted-phone key for scan-only sign-in, a same-network check, and \"That wasn't me\". Shared across AustenCloud apps.",
  "type": "module",
  "svelte": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "import": "./dist/svelte/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": ["dist", "!dist/**/*.test.*", "!dist/**/*.test-support.*"],
  "sideEffects": false,
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "uqr": "^0.1.3"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": { "optional": true }
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@types/node": "^22.0.0",
    "rimraf": "^5.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.0"
  },
  "keywords": ["firebase", "sign-in", "qr", "auth", "svelte", "austencloud"],
  "author": "Austen Cloud <austencloud@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/austencloud/shared-packages.git",
    "directory": "packages/phone-sign-in"
  },
  "publishConfig": { "access": "public" }
}
