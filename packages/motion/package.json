{
  "name": "@austencloud/motion",
  "version": "0.1.3",
  "description": "One motion clock for AustenCloud apps: duration tokens, reduced-motion-aware Svelte transitions, Crossfade, followHeight, view-transition page changes with record morphs, and a coverage scanner that keeps raw motion out.",
  "type": "module",
  "svelte": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./coverage": {
      "types": "./dist/coverage-scan.d.ts",
      "import": "./dist/coverage-scan.js"
    },
    "./css/*": "./css/*"
  },
  "files": [
    "dist",
    "css",
    "!dist/**/*.test.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@types/node": "^22.0.0",
    "jsdom": "^25.0.0",
    "rimraf": "^5.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "svelte",
    "motion",
    "transitions",
    "view-transitions",
    "austencloud"
  ],
  "author": "Austen Cloud <austencloud@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/austencloud/shared-packages.git",
    "directory": "packages/motion"
  },
  "publishConfig": {
    "access": "public"
  }
}
